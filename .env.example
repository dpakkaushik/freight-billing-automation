# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Storage ---
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
LOG_DIR=./logs

# --- Extraction engine ---
# "ollama" uses Ollama vision LLM (recommended); falls back to EasyOCR if Ollama is not running.
# "easyocr" skips Ollama and uses EasyOCR + regex directly.
EXTRACTION_ENGINE=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# --- EasyOCR (fallback) ---
# Comma-separated list of language codes for EasyOCR (e.g. "en", "en,hi")
OCR_LANGUAGES=en
# Use GPU if available (true/false). EasyOCR auto-detects but you can force off.
OCR_USE_GPU=false

# --- Pallia TMS portal ---
TMS_BASE_URL=https://pallia.tmslive.in/
TMS_USERNAME=changeme
TMS_PASSWORD=changeme
# Headless browser (true on a server, false while debugging selectors locally)
TMS_HEADLESS=true
# Slow down each action by N ms when debugging (0 in production)
TMS_SLOW_MO_MS=0

# --- Queue / Worker ---
# Maximum concurrent jobs the worker processes (FIFO; 1 = strict serial)
WORKER_CONCURRENCY=1
# Retry attempts on portal failure
JOB_MAX_RETRIES=2

# --- Authentication ---
# Use a strong secret for JWT signing. Never commit this value.
AUTH_JWT_SECRET=changeme
AUTH_TOKEN_EXPIRE_MINUTES=480

# --- Supabase (optional) ---
# If configured, API usage events are forwarded to a Supabase table.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_ANALYTICS_TABLE=api_usage_events
